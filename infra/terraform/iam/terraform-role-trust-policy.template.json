{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustOnlyTheMfaProtectedBootstrapUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<ACCOUNT_ID>:user/pharma-intel-terraform-bootstrap"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
