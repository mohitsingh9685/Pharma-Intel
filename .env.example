# Local development configuration; this example contains no working secrets.
# Create your private .env once with: python scripts/create_local_env.py
# Existing environment variables take priority over values in .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_TIME_ZONE=Asia/Kolkata

# Local PostgreSQL settings. The setup helper appends missing values to .env
# without replacing the signing key or existing database credentials.
DATABASE_NAME=pharma_intel
DATABASE_USER=pharma_app
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# Local automated tests use a separate role with permission to create and
# remove disposable test databases. The setup script generates its password.
DATABASE_TEST_USER=pharma_test_runner
DATABASE_TEST_PASSWORD=

# Sales-import safety limit and private S3 destination. Bucket and KMS values
# are not secrets, but they differ by environment. AWS credentials must come
# from the runtime role or local aws-vault session, never from this file.
SALES_IMPORT_MAX_UPLOAD_BYTES=26214400
SALES_IMPORT_RECONCILE_AFTER_MINUTES=15
SALES_IMPORT_MAX_ROWS=250000
SALES_IMPORT_DB_BATCH_SIZE=1000
SALES_IMPORT_MAX_ISSUES=10000
SALES_IMPORT_SOURCE_LOCK_WAIT_SECONDS=300
SALES_IMPORT_AWS_REGION=ap-south-1
SALES_IMPORT_S3_BUCKET=
SALES_IMPORT_S3_KMS_KEY_ARN=
